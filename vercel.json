{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' 'sha256-5tnD0gyyM3nSrX7L2op24BVHViH5PTXLxebg9LbYlf4=' 'sha256-ElShUWg/R0NC6WIMZp3N2FKE5siI90ZKCnHMHJYcUhk=' 'sha256-aOznEoqH9JdPDpf5RHI38hEKqfE69uUSiSzasn79xNw='; style-src 'self'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' https://api.github.com; manifest-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/specialists",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/docs/adaptive-missions",
      "destination": "/docs/adaptive-trails",
      "permanent": true
    },
    {
      "source": "/docs/first-mission",
      "destination": "/docs/first-trail",
      "permanent": true
    },
    {
      "source": "/docs/milo-commands",
      "destination": "/docs/scout-commands",
      "permanent": true
    },
    {
      "source": "/docs/miloops-folder",
      "destination": "/docs/teamtrail-folder",
      "permanent": true
    },
    {
      "source": "/docs/missions-and-tickets",
      "destination": "/docs/trails-and-tickets",
      "permanent": true
    }
  ]
}
